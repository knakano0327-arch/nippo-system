# ============================================================
# 営業日報システム 環境変数設定例
# このファイルをコピーして .env を作成してください。
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# データベース接続 URL
# ------------------------------------------------------------

# 開発環境（SQLite）
DATABASE_URL="file:./dev.db"

# 本番環境（PostgreSQL）
# Vercel Marketplace (Neon), Supabase, Railway などを利用してください。
# DATABASE_URL="postgresql://username:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------
# JWT 署名キー（必須 / 32文字以上のランダム文字列）
# 生成例: openssl rand -base64 32
# ------------------------------------------------------------
JWT_SECRET="your-secret-key-min-32-characters-long-change-this"

# ------------------------------------------------------------
# アプリの公開 URL（フロントエンドからのリダイレクト先などに使用）
# Vercel の場合は自動で VERCEL_URL が設定されます。
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
